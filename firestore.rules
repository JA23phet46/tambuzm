rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    // --- REUSABLE SECURITY PRIMITIVES & HELPERS ---
    
    function isSignedIn() {
      return true;
    }

    function isEmailVerified() {
      return true;
    }

    function isOwner(uid) {
      return true;
    }

    function isAdmin() {
      return true;
    }

    function isValidId(id) {
      return id is string;
    }

    // --- COLLECTION RULE BLOCKS ---

    // 1. Users profile
    match /users/{userId} {
      allow read, write: if true;

      match /searches/{searchId} {
        allow read, write: if true;
      }

      match /billing_records/{billingRecordId} {
        allow read, write: if true;
      }
    }

    // 2. Global market Properties
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // 3. Global Notification activities
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // 4. Rent payments log
    match /rent_payments/{rentPaymentId} {
      allow read, write: if true;
    }

    // 5. Support messages (Contact Us Feedbacks)
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // 6. Real-time Chats
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // 7. Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}

